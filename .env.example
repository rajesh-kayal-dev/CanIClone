# CanIClone environment template.
# Copy values into local .env files; never add real credentials to this file.

# Web application.
# Next.js reads these from apps/web/.env.local in local development.
NEXT_PUBLIC_API_URL=http://localhost:7000
NEXT_PUBLIC_APP_URL=http://localhost:6001

# Express API and WebSocket server.
PORT=7000

# PostgreSQL runtime connection used by Prisma and the API.
# The current schema requires the PostgreSQL vector extension.
DATABASE_URL=""

# Direct, non-pooler PostgreSQL connection used by Prisma CLI/migrations and
# the embedding/search utilities. Keep this separate from the runtime URL.
DIRECT_URL=""

# Optional direct connection used by hybrid search. If empty, DIRECT_URL is used.
SEARCH_DATABASE_URL=""

# Direct AI providers. These values are server-side only; never expose them as
# NEXT_PUBLIC_* variables. Gemini is primary and Groq is the configured fallback.
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Firecrawl enables live research in the Ideas and App Assistant workspaces.
FIRECRAWL_API_KEY=""

# Trends API powers the market charts and app signals integration.
TRENDS_API_KEY=""

# Optional key for the retained manual SerpAPI market-sync script.
# It is not required for the normal web/API path.
SERPAPI_API_KEY=""
