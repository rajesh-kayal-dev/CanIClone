# Root environment variables.

# Express API port.
PORT=7000

# PostgreSQL connection string.
# This project uses Neon PostgreSQL with the pgvector extension.
# Set this to your Neon project's connection string, e.g.:
#   postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
# Never commit the real .env file.
DATABASE_URL=""

# Direct (non-pooler) Neon endpoint — used only by Prisma CLI in
# packages/database (migrate status/dev/deploy, etc.) to avoid the
# transaction-pooler limitations (no DDL sessions, no shadow DB).
# Leave blank if not running migrations from this repo.
DIRECT_URL=""

# API keys for market analysis data
SERPAPI_API_KEY=""
TRENDS_API_KEY=""

# Mistral AI — server-side only. Never expose as NEXT_PUBLIC_*.
# MISTRAL_MODEL is configurable so the provider can be swapped without code changes.
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
