generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model App {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  domain       String?
  category     String
  subcategory  String?
  tagline      String?
  priceMonthly Decimal? @db.Decimal(10, 2)

  verdict           Verdict
  verdictConfidence String?
  verdictSummary    String?
  coreLoopDIY       String?
  diyTimeEstimate   String?

  requirements         Json?
  whatYouLose          Json?
  moatTags             Json?
  moatNotes            String?
  whyPeopleStillPay    String?
  priorArt             Json?
  rejectedAlternatives Json?
  relatedSlugs         Json?

  prompt        String?
  promptCurated Boolean @default(false)
  embedding     Unsupported("vector(384)")?

  pagePriority    Int     @default(3)
  verifiedOneShot Boolean @default(false)
  notes           String?

  voteCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingPlans PricingPlan[]
  alternatives Alternative[]
  aiAnalyses   AIAnalysis[]
  marketTrend  MarketTrend?

  @@index([category])
  @@index([verdict])
  @@index([name])
}

model PricingPlan {
  id    String @id @default(cuid())
  appId String

  name           String
  monthly        Decimal? @db.Decimal(10, 2)
  annualPerMonth Decimal? @db.Decimal(10, 2)
  per            String?
  limits         String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model Alternative {
  id    String @id @default(cuid())
  appId String

  name        String
  url         String
  type        String?
  repo        String?
  platforms   Json?
  description String?
  stars       Int?
  lastCommit  String?
  selfHost    String?
  checkedOn   String?
  facts       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model AIAnalysis {
  id    String @id @default(cuid())
  appId String

  verdict  String?
  analysis Json?

  buildabilityScore Int?
  complexity        String?
  estimatedEffort   String?

  requiredFeatures Json?
  recommendedStack Json?
  limitations      Json?
  buildPlan        Json?
  generatedPrompt  String?

  model String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

enum Verdict {
  yes
  kinda
  no
}

model MarketTrend {
  id    String @id @default(cuid())
  appId String @unique

  source String @default("Google Trends")
  query  String

  trendDirection  String?
  growthPercent   Int?
  currentInterest Int?
  averageInterest Int?

  timelineData    Json?
  regionalData    Json?
  relatedQueries  Json?

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model MarketCache {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Ideas module — anonymous, login-free idea workspace with an AI conversation.
// AnonymousUser 1─* Idea 1─* {AIMessage, Research, Prompt, Mvp}. Every child
// relation cascades on delete so removing an idea removes its whole workspace.
// ---------------------------------------------------------------------------

model AnonymousUser {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ideas Idea[]
}

enum IdeaSource {
  USER
  RESEARCH
}

enum IdeaStatus {
  DRAFT
  SAVED
}

model Idea {
  id              String     @id @default(cuid())
  anonymousUserId String

  title       String?
  description String?
  source      IdeaSource @default(USER)
  status      IdeaStatus @default(DRAFT)

  // Latest generated development prompt (denormalized snapshot for quick display).
  prompt String?

  targetUsers String?
  purpose     String?
  budget      String?
  technology  String?

  // Latest research analysis snapshot; full history lives in `researchRecords`.
  research String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anonymousUser   AnonymousUser @relation(fields: [anonymousUserId], references: [id], onDelete: Cascade)
  messages        AIMessage[]
  researchRecords Research[]
  prompts         Prompt[]
  mvps            Mvp[]

  @@index([anonymousUserId])
  @@index([status])
}

model AIMessage {
  id     String @id @default(cuid())
  ideaId String

  // role: user | assistant | system | tool
  role String
  // kind: chat | analysis | research | challenge | prompt | mvp
  kind    String  @default("chat")
  content String

  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

model Research {
  id     String @id @default(cuid())
  ideaId String

  query    String
  // Raw Firecrawl results (urls, titles, snippets, markdown).
  results  Json?
  // Mistral's synthesized analysis / challenge over the results.
  analysis String?
  status   String  @default("complete")

  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

model Prompt {
  id     String @id @default(cuid())
  ideaId String

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

model Mvp {
  id     String @id @default(cuid())
  ideaId String

  // Full MVP.md markdown document.
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}
