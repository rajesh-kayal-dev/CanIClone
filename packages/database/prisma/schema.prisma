generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model App {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  domain       String?
  category     String
  subcategory  String?
  tagline      String?
  priceMonthly Decimal? @db.Decimal(10, 2)

  verdict           Verdict
  verdictConfidence String?
  verdictSummary    String?
  coreLoopDIY       String?
  diyTimeEstimate   String?

  requirements         Json?
  whatYouLose          Json?
  moatTags             Json?
  moatNotes            String?
  whyPeopleStillPay    String?
  priorArt             Json?
  rejectedAlternatives Json?
  relatedSlugs         Json?

  prompt        String?
  promptCurated Boolean @default(false)
  embedding     Unsupported("vector(384)")?

  pagePriority    Int     @default(3)
  verifiedOneShot Boolean @default(false)
  notes           String?

  voteCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingPlans PricingPlan[]
  alternatives Alternative[]
  aiAnalyses   AIAnalysis[]

  @@index([category])
  @@index([verdict])
  @@index([name])
}

model PricingPlan {
  id    String @id @default(cuid())
  appId String

  name           String
  monthly        Decimal? @db.Decimal(10, 2)
  annualPerMonth Decimal? @db.Decimal(10, 2)
  per            String?
  limits         String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model Alternative {
  id    String @id @default(cuid())
  appId String

  name        String
  url         String
  type        String?
  repo        String?
  platforms   Json?
  description String?
  stars       Int?
  lastCommit  String?
  selfHost    String?
  checkedOn   String?
  facts       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model AIAnalysis {
  id    String @id @default(cuid())
  appId String

  buildabilityScore Int?
  complexity        String?
  estimatedEffort   String?

  requiredFeatures Json?
  recommendedStack Json?
  limitations      Json?
  buildPlan        Json?
  generatedPrompt  String?

  model String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

enum Verdict {
  yes
  kinda
  no
}
