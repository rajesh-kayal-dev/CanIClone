# The database package reads its connection string via prisma.config.ts
# (env("DATABASE_URL")) and confirms it from packages/database/.env.
# This project uses Neon PostgreSQL with the pgvector extension.
#   postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
DATABASE_URL=""

# Direct (non-pooler) Neon endpoint used ONLY by Prisma CLI/migration commands
# (prisma migrate dev/status/deploy). The runtime keeps using DATABASE_URL.
# Neon direct host has NO "-pooler" suffix in the hostname, e.g.:
#   postgresql://USER:PASSWORD@ep-xxx-00.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=""